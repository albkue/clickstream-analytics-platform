# Copy to .env and adjust. Never commit .env.

# ------------------------------------------------------------- Postgres ----
POSTGRES_USER=clickstream
POSTGRES_PASSWORD=clickstream
POSTGRES_DB=clickstream
POSTGRES_HOST=localhost
# Host port for the container. 5432/5434 are often already taken by another
# local Postgres (project1 uses 5434); this stack uses 5435 to stay out of
# the way.
POSTGRES_PORT=5435

# ---------------------------------------------------------------- Kafka ----
# Host-side bootstrap server. Inside the compose network the broker is
# reachable as kafka:9092; from the host it is localhost:9094.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_PORT=9094
KAFKA_TOPIC=clickstream.events
KAFKA_CONSUMER_GROUP=clickstream-warehouse-loader

# Partition count for auto-created topics. Events are keyed by anonymous_id,
# so every event for one visitor lands on one partition and stays ordered --
# which is what makes gap-based sessionization correct.
KAFKA_TOPIC_PARTITIONS=6

# ------------------------------------------------------------- Consumer ----
# Rows buffered before a single COPY into raw.events. Offsets are committed
# only after that write commits, which is what makes ingestion at-least-once.
CONSUMER_BATCH_SIZE=500
# Flush a partial batch after this many seconds so a quiet stream still lands.
CONSUMER_BATCH_TIMEOUT_SECONDS=5.0
# Stop after this many seconds with no new messages. 0 = run until Ctrl-C.
CONSUMER_IDLE_TIMEOUT_SECONDS=0

# ------------------------------------------------------------ Warehouse ----
# Inactivity gap that closes a session, in minutes. 30 is the GA4/Adobe
# convention; change it and `transform --full-refresh` to re-sessionize.
SESSION_TIMEOUT_MINUTES=30

# Directory holding the dbt-style SQL models.
MODELS_DIR=models

# ------------------------------------------------------------ Generator ----
# Product/page catalog used by the synthetic event generator.
CATALOG_FILE=config/catalog.json
# Seed for the generator. Set to an integer for reproducible streams.
GENERATOR_SEED=
